<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 2 needs no permissions beyond network. RECORD_AUDIO arrives with
         the voice work in Phase 8; requesting it now would put an unexplained
         microphone permission on a calculator-looking app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Security-relevant application attributes, explained here because comments
      cannot live between attributes:

      allowBackup=false, fullBackupContent=false, dataExtractionRules
          An encrypted identity vault must not be copied off the device by
          Android's automatic backup, where it would sit outside the Keystore
          protection that makes it safe at rest.

      usesCleartextTraffic=false
          No cleartext anywhere. The XMPP transport uses TLS, and over I2P the
          .b32 destination is itself cryptographically authenticated.
    -->
    <application
        android:name=".OtrApplication"
        android:label="@string/app_name"
        android:theme="@style/Theme.OTRv4Plus"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.OTRv4Plus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets the user hand a diagnostic report to an app of their choosing.

          exported=false and grantUriPermissions=true is the pair that matters:
          no other app may ask this provider for anything, and access is only
          ever the one-shot, read-only grant that rides along with the share
          Intent for the single file the user picked. The APK has no storage
          permission and gains none from this.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
