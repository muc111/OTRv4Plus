<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The connection outlives the screen, which on Android means a foreground
      service and therefore a notification the user can see and stop. Without
      it the process is killed when backgrounded, the I2P tunnel goes with it,
      and every message sent in the meantime is simply lost.

      dataSync is the honest type: this is a long-lived network session the
      user asked for. It is not a media, location, or call service and must not
      claim to be one.

      POST_NOTIFICATIONS is API 33+. Denying it does not stop the service; it
      only hides the notification, so the app asks for it but does not depend
      on it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      THE MOMENT THIS WAITED FOR. This declaration was deliberately held
      back, with the note that a permission the app cannot yet use is one
      the user cannot evaluate, and that it would be requested when voice
      could use it. Until now voice could not be reached from Android at
      all: the bridge had no start_call, answer_call or end_call.

      It does now, so the permission is declared and REQUESTED AT THE POINT
      OF USE, when the user places or answers a call, never at launch.
      crypto/MicPermission.kt holds the decision and MicPermissionTest
      drives it, including the case that matters: once Android stops showing
      the dialog, asking again is a button that silently does nothing, so
      the app says so and offers Settings instead.

      Audio is encrypted on this device by otrv4plus_voice, carried over
      I2P, and never written to disk.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      A call is a call. dataSync above covers the long-lived XMPP session; a
      live voice call is a different foreground type, and claiming the wrong
      one is exactly what the dataSync comment refuses to do.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Security-relevant application attributes, explained here because comments
      cannot live between attributes:

      allowBackup=false, fullBackupContent=false, dataExtractionRules
          An encrypted identity vault must not be copied off the device by
          Android's automatic backup, where it would sit outside the Keystore
          protection that makes it safe at rest.

      usesCleartextTraffic=false
          No cleartext anywhere. The XMPP transport uses TLS, and over I2P the
          .b32 destination is itself cryptographically authenticated.
    -->
    <application
        android:name=".OtrApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.OTRv4Plus"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.OTRv4Plus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one owner of the connection.

          exported=false: nothing outside this app may start, stop or bind to
          it. The Intent that starts it carries the account password, and an
          exported service would be an invitation to send one.

          No intent-filter, for the same reason: it is started by explicit
          Intent from this app and by nothing else.
        -->
        <service
            android:name=".connection.OtrConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Lets the user hand a diagnostic report to an app of their choosing.

          exported=false and grantUriPermissions=true is the pair that matters:
          no other app may ask this provider for anything, and access is only
          ever the one-shot, read-only grant that rides along with the share
          Intent for the single file the user picked. The APK has no storage
          permission and gains none from this.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
