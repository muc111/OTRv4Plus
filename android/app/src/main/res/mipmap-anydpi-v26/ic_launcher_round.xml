<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. minSdk is 26, so every device we support uses this pair and
  the PNGs in mipmap-*dpi/ic_launcher.png are only for launchers that ask for
  the legacy shape.

  The foreground art sits at 60% of the 108dp canvas. The safe zone is 66dp of
  108dp — anything larger and a circular mask takes the hat brim off.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
