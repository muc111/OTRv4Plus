# ── Built .so files in project root ──────────────────────────────────────────
# These are compiled locally and differ per device/platform.
# Distribution binaries go in prebuilt/ instead.
/*.so
/*.cpython-*.so

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
dist/
build/

# ── Rust ─────────────────────────────────────────────────────────────────────
Rust/target/

# ── Android ──────────────────────────────────────────────────────────────────
# Written by :app:syncPythonSources, which copies the orchestration layer into
# the APK's source set. It exists so there is exactly ONE copy of otrv4+.py in
# the repository -- committing the copies would create precisely the second
# copy the task exists to prevent, and it would silently go stale.
/android/app/src/main/python/
# Built per ABI from Rust/ by maturin, or downloaded from the `rust` CI job.
/android/app/wheels/

# ── Test / tooling cache ──────────────────────────────────────────────────────
.pytest_cache/
.hypothesis/

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
otr-env/

# ── Explicitly keep prebuilt/ binaries ───────────────────────────────────────
!prebuilt/*.so

libera.pem
*.pem

libera.pem
*.pem
otrv4_core.so
*.so

.otrv4plus/
*.log
__pycache__/
