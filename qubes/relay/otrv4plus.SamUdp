#
# qrexec service, in sys-i2p: the UDP leg of one SAM datagram session, for a
# chat qube with no network. dom0's /etc/qubes/policy.d/30-otrv4plus.policy
# allows it from otr-chat only.
exec /usr/lib/otrv4plus/otrv4plus-qubes-relay service
